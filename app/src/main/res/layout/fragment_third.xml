<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.become.ThirdFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:elevation="5dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            tools:ignore="MissingConstraints">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="License Information"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_general"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="04dp"
                app:errorEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:hintTextColor="@color/teal_700"
                app:boxStrokeColor="@color/teal_700"
                app:counterEnabled="true"
                app:counterMaxLength="06"
                tools:ignore="UnusedAttribute">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Punjab bar licence"
                    android:clickable="false"
                    android:inputType="numberDecimal"
                    tools:ignore="HardcodedText" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_high"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:errorEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:hintTextColor="@color/teal_700"
                app:boxStrokeColor="@color/teal_700"
                app:counterEnabled="true"
                app:counterMaxLength="06"
                tools:ignore="UnusedAttribute">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_high"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="High Court License"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_supreme"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="04dp"
                app:errorEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:hintTextColor="@color/teal_700"
                app:counterEnabled="true"
                app:counterMaxLength="06"
                app:boxStrokeColor="@color/teal_700"
                tools:ignore="UnusedAttribute">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_supreme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Supreme Court License"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="08dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/back_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="04dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/white"
                    android:shadowColor="@color/black"
                    android:text="Back"
                    android:textColor="@color/black" />
                <Button
                    android:id="@+id/save_btn"
                    android:layout_marginStart="04dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#002C28"
                    android:text="Next"
                    android:textColor="@color/white"
                    />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>